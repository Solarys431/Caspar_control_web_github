# Caspar Control Web - Environment Variables
# Copia questo file in .env e configura i valori

# Supabase Mode: 'cloud' o 'local'
SUPABASE_MODE=cloud

# === CLOUD SUPABASE ===
# Configura questi valori con il tuo progetto Supabase
SUPABASE_CLOUD_URL=https://your-project.supabase.co
SUPABASE_CLOUD_SERVICE_KEY=your-service-role-key

# Per il client React
REACT_APP_SUPABASE_CLOUD_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_CLOUD_ANON_KEY=your-anon-key

# === LOCAL SUPABASE ===
# Valori di default per Supabase locale (supabase start)
SUPABASE_LOCAL_URL=http://127.0.0.1:55321
SUPABASE_LOCAL_SERVICE_KEY=your-local-service-key

REACT_APP_SUPABASE_LOCAL_URL=http://127.0.0.1:55321
REACT_APP_SUPABASE_LOCAL_ANON_KEY=your-local-anon-key

# === CASPARCG ===
CASPAR_HOST=localhost
CASPAR_PORT=5250

# === SERVER ===
PORT=3001
